# Local secrets for `wrangler pages dev` (Cloudflare Pages Functions).
# Copy this file to `.dev.vars` (which is gitignored) and fill in the real key.
#
#   cp .dev.vars.example .dev.vars
#   npm run build
#   npx wrangler pages dev public
#
# In production, set these as encrypted secrets on the Pages project instead
# (Cloudflare dashboard → Settings → Variables and Secrets) — see DEPLOY.md.

# Required: your Anthropic API key (server-side only — never shipped to the browser).
ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the model (defaults to claude-opus-4-8).
# ANTHROPIC_MODEL=claude-opus-4-8
